HTTP_ADDR=:8080
POSTGRES_DB=gatehouse
POSTGRES_USER=gatehouse
POSTGRES_PASSWORD=gatehouse_dev
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433

# Keep true outside local HTTP development
SESSION_COOKIE_SECURE=false

# local generation: openssl rand -base64 32
MFA_ENCRYPTION_KEY_ID=local-v1
MFA_ENCRYPTION_KEY_BASE64=

DATABASE_URL=postgres://gatehouse:gatehouse_dev@localhost:5432/gatehouse?sslmode=disable
TEST_DATABASE_URL=postgres://gatehouse:gatehouse_test@localhost:5433/gatehouse_test?sslmode=disable

# Development-only delivery: prints verification links in API logs
EMAIL_DELIVERY_MODE=log
WEB_APP_URL=http://localhost:5173

# Public Gatehouse OIDC identity. HTTPS is required outside localhost.
OIDC_ISSUER=http://localhost:5173

# Stable identifier published in JWT headers and JWKS.
OIDC_SIGNING_KEY_ID=local-rs256-v1

# Resolved relative to the backend process working directory.
OIDC_SIGNING_PRIVATE_KEY_FILE=.local/oidc-signing-key.pem

# Create a confidential Gatehouse
# application with the exact callback below, then paste its one-time credentials.
EMPLOYEE_PORTAL_HTTP_ADDR=:8090
EMPLOYEE_PORTAL_OIDC_ISSUER=http://localhost:5173
EMPLOYEE_PORTAL_OIDC_CLIENT_ID=
EMPLOYEE_PORTAL_OIDC_CLIENT_SECRET=
EMPLOYEE_PORTAL_OIDC_REDIRECT_URI=http://localhost:8090/oauth/callback
EMPLOYEE_PORTAL_COOKIE_SECURE=false

# Configure the SQS source queue from infra/audit-exports.yaml.
# The API uses the queue URL; the standalone worker also needs the private bucket.
AWS_REGION=
AUDIT_EXPORT_QUEUE_URL=
AUDIT_EXPORT_BUCKET=

# Optional upstream OIDC federation. Leave the redirect URI empty to disable it.
# Local generation: openssl rand -base64 32
UPSTREAM_OIDC_REDIRECT_URI=
UPSTREAM_OIDC_ENCRYPTION_KEY_ID=local-federation-v1
UPSTREAM_OIDC_ENCRYPTION_KEY_BASE64=

# Keep both false in production. These only support local test providers.
UPSTREAM_OIDC_ALLOW_HTTP=false
UPSTREAM_OIDC_ALLOW_PRIVATE_ADDRESSES=false
