HTTP_ADDR=:8080
POSTGRES_DB=gatehouse
POSTGRES_USER=gatehouse
POSTGRES_PASSWORD=gatehouse_dev
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433

# Keep true outside local HTTP development
SESSION_COOKIE_SECURE=false

# local generation: openssl rand -base64 32
MFA_ENCRYPTION_KEY_ID=local-v1
MFA_ENCRYPTION_KEY_BASE64=

DATABASE_URL=postgres://gatehouse:gatehouse_dev@localhost:5432/gatehouse?sslmode=disable
TEST_DATABASE_URL=postgres://gatehouse:gatehouse_test@localhost:5433/gatehouse_test?sslmode=disable

# Development-only delivery: prints verification links in API logs
EMAIL_DELIVERY_MODE=log
WEB_APP_URL=http://localhost:5173

# Public Gatehouse OIDC identity. HTTPS is required outside localhost.
OIDC_ISSUER=http://localhost:8080

# Stable identifier published in JWT headers and JWKS.
OIDC_SIGNING_KEY_ID=local-rs256-v1

# Resolved relative to the backend process working directory.
OIDC_SIGNING_PRIVATE_KEY_FILE=.local/oidc-signing-key.pem